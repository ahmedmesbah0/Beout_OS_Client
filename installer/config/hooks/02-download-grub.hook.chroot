#!/bin/sh
set -e

echo "============================================="
echo "Downloading GRUB offline packages..."
echo "============================================="

# Ensure apt cache is up to date inside chroot
apt-get update

# Create directory for offline packages
mkdir -p /opt/beout_os/installer/packages
cd /opt/beout_os/installer/packages

# Download GRUB packages and dependencies
apt-get download grub-pc grub-pc-bin grub-efi-amd64 grub-efi-amd64-bin grub2-common grub-common ucf libfile-copy-recursive-perl
